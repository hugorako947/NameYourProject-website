# =============================================================================
# NameYourProject — Variables d'environnement
#
# En local : copie ce fichier en .env.local et remplis les valeurs.
# En ligne : saisis ces mêmes variables dans le tableau de bord de ton
#            hébergeur (Vercel ou Render) — .env.local n'est jamais mis en ligne.
# Après toute modification : redémarre le serveur (Ctrl+C puis npm run dev).
# =============================================================================

# ── OBLIGATOIRE ──────────────────────────────────────────────────────────────
# Clé de l'IA Gemini (Google AI Studio). Active la facturation avant la mise en ligne.
GOOGLE_GENERATIVE_AI_API_KEY=

# ── RECOMMANDÉ ───────────────────────────────────────────────────────────────
# Ton secret d'administrateur (générations illimitées via la page /admin).
# Génère-le dans PowerShell avec : [guid]::NewGuid()
ADMIN_BYPASS_SECRET=

# ── COMPTEUR PARTAGÉ (indispensable sur Vercel, et dès que le paiement sera actif) ─
# Laisser vide = compteur en mémoire (suffisant en local).
# Remplir = compteur Upstash activé automatiquement, sans toucher au code.
# (Sur Vercel, l'intégration Upstash peut aussi fournir KV_REST_API_URL / KV_REST_API_TOKEN :
#  ils sont reconnus également.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Facultatif : secret utilisé pour transformer les IP en empreintes (sinon le jeton Upstash sert de secret)
IP_HASH_SALT=

# ── PAIEMENT (achat de générations) ─────────────────────────────────────────
# Le paiement ne s'active QUE si tout ce qui est nécessaire est rempli ; sinon la
# fenêtre d'achat affiche "bientôt disponible". Au démarrage, le terminal indique
# "[paiement] Activé" ou la liste de ce qui manque.
#   En local : STRIPE_SECRET_KEY + CREDITS_SECRET suffisent pour tester.
#   En ligne : il faut AUSSI STRIPE_WEBHOOK_SECRET et les clés Upstash ci-dessus.

# Clé secrète Stripe (Tableau de bord Stripe → Développeurs → Clés API).
# Commence par sk_test_… en mode test (aucun vrai paiement), sk_live_… en réel.
STRIPE_SECRET_KEY=
# Secret des notifications Stripe (Développeurs → Webhooks → ton point de terminaison).
# Adresse à déclarer : https://TON-DOMAINE/api/stripe/webhook
# Événements : checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=
# Secret qui transforme les e-mails des acheteurs en empreintes (32 caractères ou plus).
# Génère-le dans PowerShell avec : [guid]::NewGuid().ToString() + [guid]::NewGuid().ToString()
# ⚠️ NE JAMAIS LE MODIFIER après la mise en ligne : les clients perdraient leurs générations.
CREDITS_SECRET=
# Facultatif : calcul automatique des taxes (nécessite Stripe Tax, service payant).
# STRIPE_AUTOMATIC_TAX=true
# Facultatif : Stripe Managed Payments (Stripe devient revendeur officiel et gère la TVA).
# Vérifie d'abord ton éligibilité et les frais dans le tableau de bord Stripe.
# STRIPE_MANAGED_PAYMENTS=true

# ── E-MAILS (codes de connexion, confirmations d'achat) ─────────────────────
# Clé du service d'envoi Resend (resend.com). Sans elle, en local, les e-mails
# s'affichent simplement dans le terminal.
RESEND_API_KEY=
# Expéditeur, avec un domaine vérifié chez Resend.
EMAIL_FROM=NameYourProject <contact@nameyourproject.com>
# Adresse publique du site (liens dans les e-mails). Sinon déduite automatiquement.
# NEXT_PUBLIC_SITE_URL=https://nameyourproject.com

# ── FACULTATIF ───────────────────────────────────────────────────────────────
# Commission sur les réservations de domaines (programme d'affiliation Namecheap).
NAMECHEAP_AFFILIATE_ID=

# Modèle IA prioritaire (ex : un modèle Pro, uniquement avec la facturation activée).
# GEMINI_MODEL=
# Modèles de secours, séparés par des virgules (sinon : gemini-3.7-flash,gemini-flash-lite-latest).
# GEMINI_FALLBACK_MODELS=

# ── PLUS TARD ────────────────────────────────────────────────────────────────
# Anti-robots Cloudflare Turnstile (compte gratuit sur cloudflare.com → Turnstile).
# Utile uniquement en ligne : laisser à false en local. S'active si les deux clés sont remplies.
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── PLUS NÉCESSAIRE ──────────────────────────────────────────────────────────
# RAPIDAPI_KEY : remplacée par la vérification officielle des registres (RDAP), gratuite.
